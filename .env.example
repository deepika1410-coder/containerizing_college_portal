# ==========================================
# CampusFlow Environment Configuration
# ==========================================

# Application Port
PORT=5000
NODE_ENV=development

# Database Connection (Single Relational Engine: PostgreSQL)
# Docker Compose default:
DATABASE_URL=postgresql://campusflow:campusflow_secret@localhost:5432/campusflow_db

# Managed PostgreSQL credentials (e.g. AWS RDS / Supabase / Azure / GCP):
# DATABASE_URL=postgresql://dbuser:password@your-db-host.rds.amazonaws.com:5432/campusflow_prod?sslmode=require

# Database individual variables if not using DATABASE_URL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=campusflow
DB_PASSWORD=campusflow_secret
DB_NAME=campusflow_db

# Security & Authentication
JWT_SECRET=campusflow_ultra_secure_jwt_secret_token_key_2026
JWT_EXPIRES_IN=24h

# Auto-seed database on startup (Populates demo accounts, courses, attendance, results)
AUTO_SEED=true

# Frontend URL
APP_URL=http://localhost:5173

# Email Service Provider (For Password Resets)
# Options: 'console' (local logs), 'smtp' (MailHog, SendGrid, Amazon SES)
EMAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
